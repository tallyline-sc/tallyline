* text=auto eol=lf

*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.webp binary
*.ico binary
*.icns binary
*.jxr binary
*.avif binary
*.exr binary
*.onnx binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
*.zip binary
*.gz binary
*.msi binary
*.pdf binary

corpus/public/**/*.jpg filter=lfs diff=lfs merge=lfs -text
corpus/public/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
corpus/public/**/*.png filter=lfs diff=lfs merge=lfs -text

Cargo.lock -linguist-generated
crates/ui/assets/fonts/**/OFL.txt -text whitespace=-blank-at-eol
supply-chain/notices/accesskit/NOTICE whitespace=-blank-at-eof
supply-chain/notices/opencv-linear/LICENSE -text
crates/adapter-ocr/assets/**/*.onnx filter=lfs diff=lfs merge=lfs -text
crates/adapter-ocr/assets/small/ppocrv6_dict.txt -text
supply-chain/notices/paddleocr/LICENSE -text
crates/adapter-ocr/assets/runtime/**/*.dll filter=lfs diff=lfs merge=lfs -text
crates/adapter-ocr/assets/runtime/**/*.so.* filter=lfs diff=lfs merge=lfs -text
supply-chain/notices/onnxruntime-windows/* -text whitespace=-blank-at-eol,-blank-at-eof
supply-chain/notices/onnxruntime-linux/* -text whitespace=-blank-at-eol,-blank-at-eof

supply-chain/wix/tool-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

supply-chain/wix/wix7-self-compiled.patch whitespace=-blank-at-eol

crates/ui/assets/fonts/material-symbols/LICENSE -text
